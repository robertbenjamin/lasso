#!/bin/zsh
# herdr-conf <key>: one value from lasso.json in the app folder (next to bin/).
# A string prints as is, with ~ expanded. An object prints "key<TAB>value" lines.
# No file or no key: prints nothing. HERDR_WORK_ROOT overrides workRoot (the tests use it).
emulate -L zsh
setopt err_exit pipe_fail
source ${0:A:h}/lib.zsh
if [[ $1 == workRoot && -n $HERDR_WORK_ROOT ]]; then print -r -- $HERDR_WORK_ROOT; exit 0; fi
file=${LASSO_BIN:h}/lasso.json
[[ -r $file ]] || exit 0
jq -r --arg key $1 --arg home $HOME '
  .[$key] // empty
  | if type == "object" then to_entries[] | "\(.key)\t\(.value)"
    elif type == "string" then select(. != "") | sub("^~(?=/|$)"; $home)
    else . end' $file
