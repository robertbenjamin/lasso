#!/usr/bin/env python3
# herdr-conf <key>: one value from lasso.json in the app folder (next to bin/).
# A string prints as is, with ~ expanded. An object prints "key<TAB>value" lines.
# No file or no key: prints nothing. HERDR_WORK_ROOT overrides workRoot (the tests use it).
import json, os, sys
home = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
try:
    v = json.load(open(os.path.join(home, "lasso.json"))).get(sys.argv[1])
except OSError:
    v = None
except ValueError as e:
    sys.exit(f"herdr-conf: bad lasso.json: {e}")
if sys.argv[1] == "workRoot":
    v = os.environ.get("HERDR_WORK_ROOT") or v
if isinstance(v, dict):
    print("\n".join(f"{k}\t{x}" for k, x in v.items()))
elif v:
    print(os.path.expanduser(v))
