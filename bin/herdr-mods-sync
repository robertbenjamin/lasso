#!/bin/zsh
# herdr-mods-sync: brings upstream changes to Herdr's shipped mods into lasso's clones of them.
#
#   herdr-mods-sync status [--quiet]   each clone: the version it's based on, Herdr's version,
#                                      and how many lines of its stock files are lasso's edits.
#                                      --quiet: print only stale clones; exit 1 when any is stale.
#   herdr-mods-sync share              copy mods/tasks/shared.js to every other mod that has one.
#   herdr-mods-sync merge [--to V]     three-way merge the stock changes from the clone's
#                                      cloned_from version to V (default: the running Herdr)
#                                      into each stale clone, then bump its cloned_from.
#
# A clone is a mods/<name>/ whose mod.json has cloned_from {name, version}. The stock sources
# come from github.com/herdrdev/herdr-app (defaults/mods/<name>/ at tag v<version>), cached in
# ~/.cache/lasso/herdr-app. Before merging, the stock files get the renames Herdr's mod.clone
# makes (mods/<stock>/ asset paths, mod: "<stock>" overlay names), so those don't count as
# lasso's edits. Overlapping edits are left as git conflict markers in the file; nothing is
# committed. The merge refuses to run while mods/ has uncommitted changes, so
# `git checkout mods` undoes it.
emulate -L zsh
setopt err_exit pipe_fail
source ${0:A:h}/lib.zsh

APP=${HERDR_APP_HOME:-~/.config/herdr-app}
CACHE=~/.cache/lasso/herdr-app
UPSTREAM=https://github.com/herdrdev/herdr-app
SHARED=$APP/mods/tasks/shared.js
TMP=$(mktemp -d)
trap 'rm -rf $TMP' EXIT

die() { print -u2 -r -- "herdr-mods-sync: $*"; exit 1; }

herdr_version() {
  local out=$(herdr-app --version)
  [[ $out =~ '[0-9]+\.[0-9]+\.[0-9]+' ]] || die "can't read the Herdr version from: $out"
  print -r -- $MATCH
}

# Is version $1 older than $2?
older() { local v=($1 $2); [[ $1 != $2 && ${${(n)v}[1]} == $1 ]]; }

# Each clone as "<clone> <stock> <version>", one per line.
clones() {
  local dir
  for dir in $APP/mods/*(/N); do
    [[ -f $dir/mod.json ]] || continue
    jq -r --arg clone ${dir:t} '.cloned_from | select(.name and .version) | "\($clone) \(.name) \(.version)"' $dir/mod.json 2>/dev/null || true
  done
}

# The cached upstream clone, with every tag in $@: fetched once per run, when one is missing.
fetched=
upstream() {
  if [[ ! -d $CACHE/.git ]]; then
    mkdir -p ${CACHE:h}
    git clone -q --filter=blob:none --no-checkout $UPSTREAM $CACHE
    fetched=1
  fi
  local tag missing=()
  for tag; do git -C $CACHE rev-parse -q --verify refs/tags/$tag >/dev/null || missing+=$tag; done
  if (( $#missing )) && [[ -z $fetched ]]; then
    git -C $CACHE fetch -q --tags origin
    fetched=1 missing=()
    for tag; do git -C $CACHE rev-parse -q --verify refs/tags/$tag >/dev/null || missing+=$tag; done
  fi
  (( ! $#missing )) || die "upstream has no tag ${(j:, :)missing}"
}

# Writes stock mod $1 at version $2 into folder $4, with the renames mod.clone makes for clone
# $3, and without mod.json (the clone's own: place, title, cloned_from).
stock_files() {
  local stock=$1 version=$2 clone=$3 out=$4 f
  mkdir -p $TMP/archive $out
  git -C $CACHE archive v$version defaults/mods/$stock | tar -x -C $TMP/archive
  [[ -d $TMP/archive/defaults/mods/$stock ]] || die "no shipped mod '$stock' at v$version"
  mv $TMP/archive/defaults/mods/$stock/*(DN) $out/
  rm -rf $TMP/archive $out/mod.json
  for f in $out/**/*(.N); do
    grep -Iq . $f || continue  # binary: as it is
    sed -i '' -E "s#mods/$stock/#mods/$clone/#g; s#(mod\"?[[:space:]]*:[[:space:]]*\")$stock(\")#\\1$clone\\2#g" $f
  done
}

# The files under folder $1, as paths relative to it.
files_in() { local f; for f in $1/**/*(.DN); do print -r -- ${f#$1/}; done; }

# Lines changed between two files (added + removed), as git diff counts them.
edited_lines() {
  local add rem _
  git diff --no-index --numstat $1 $2 | read -r add rem _ || true
  if [[ -z $add ]]; then print 0
  elif [[ $add == - ]]; then print 1  # binary
  else print $(( add + rem )); fi
}

# mods/tasks/shared.js's copies: Herdr loads a mod's code only from its own folder.
shared_copies() { local p; for p in $APP/mods/*/shared.js(N); do [[ $p == $SHARED ]] || print -r -- $p; done; }

share() {
  local p
  for p in ${(f)"$(shared_copies)"}; do
    cp $SHARED $p
    print "copied to mods/${p:h:t}/shared.js"
  done
}

show_status() {
  local quiet=$1 now stale=0 clone stock ver mark rel n
  local p
  for p in ${(f)"$(shared_copies)"}; do
    cmp -s $p $SHARED || print "warning: mods/${p:h:t}/shared.js differs from mods/tasks/shared.js: run herdr-mods-sync share"
  done
  now=$(herdr_version)
  for clone stock ver in ${=$(clones)}; do
    if older $ver $now; then (( ++stale )); mark="behind (Herdr $now)"; else mark=current; fi
    if [[ -n $quiet ]]; then
      [[ $mark == current ]] || print "$clone: based on $stock $ver, Herdr is $now"
      continue
    fi
    upstream v$ver
    local base=$TMP/$clone-base dir=$APP/mods/$clone edits=() own=()
    stock_files $stock $ver $clone $base
    for rel in ${(f)"$(files_in $base)"}; do
      if [[ -e $dir/$rel ]]; then n=$(edited_lines $base/$rel $dir/$rel); else n=deleted; fi
      [[ $n == 0 ]] || edits+="$rel $n"
    done
    for rel in ${(f)"$(files_in $dir)"}; do
      [[ -e $base/$rel || $rel == *.d.ts || ${rel:t} == (jsconfig|mod).json ]] || own+=$rel
    done
    print "$clone  ← $stock $ver  $mark"
    print "  edited stock lines: ${${(j:, :)edits}:-none}"
    (( ! $#own )) || print "  lasso's own files: ${(j:, :)own}"
  done
  if [[ -n $quiet ]]; then exit $(( stale > 0 )); fi
  (( ! stale )) || print "\n$stale clone(s) behind. Run: herdr-mods-sync merge"
}

merge() {
  local to=${1:-$(herdr_version)} dirty todo=() tags=() conflicted=() notes=()
  local clone stock ver rel b n mine rc
  dirty=$(git -C $APP status --porcelain -- mods)
  [[ -z $dirty ]] || die "mods/ has uncommitted changes; commit or stash them first:"$'\n'$dirty
  for clone stock ver in ${=$(clones)}; do
    older $ver $to && todo+=("$clone $stock $ver") tags+=v$ver
  done
  if (( ! $#todo )); then print "Every clone is based on $to or later. Nothing to merge."; return; fi
  upstream v$to ${(u)tags}
  for clone stock ver in ${=todo}; do
    local dir=$APP/mods/$clone base=$TMP/$clone-base new=$TMP/$clone-new changed=()
    stock_files $stock $ver $clone $base
    stock_files $stock $to $clone $new
    for rel in ${(fou)"$(files_in $base; files_in $new)"}; do
      b=$base/$rel n=$new/$rel mine=$dir/$rel
      [[ -e $b && -e $n ]] && cmp -s $b $n && continue
      if [[ ! -e $b ]]; then  # upstream added it
        if [[ ! -e $mine ]]; then mkdir -p ${mine:h}; cp $n $mine; changed+="+$rel"
        elif ! cmp -s $mine $n; then notes+="$clone/$rel: upstream added a file lasso already has; compare by hand"; fi
      elif [[ ! -e $mine ]]; then  # lasso deleted it
        notes+="$clone/$rel: lasso removed this file and upstream changed it; check the change still doesn't matter"
      elif [[ ! -e $n ]]; then  # upstream deleted it
        if cmp -s $mine $b; then rm $mine; changed+="-$rel"
        else notes+="$clone/$rel: upstream removed this file, lasso edited it; kept"; fi
      elif cmp -s $mine $b; then
        cp $n $mine; changed+=$rel
      else
        rc=0
        git merge-file --diff3 -L "lasso ($clone)" -L "$stock $ver" -L "$stock $to" $mine $b $n 2>$TMP/err || rc=$?
        (( rc <= 127 )) || die "git merge-file failed on $mine: $(<$TMP/err)"
        if (( rc )); then
          changed+="$rel ($rc conflict${${rc:#1}:+s})"; conflicted+=mods/$clone/$rel
        else changed+=$rel; fi
      fi
    done
    jq --arg v $to '.cloned_from.version = $v' $dir/mod.json > $TMP/mod.json && mv $TMP/mod.json $dir/mod.json
    print "$clone  ← $stock $ver → $to: ${${(j:, :)changed}:-no stock changes}"
  done
  for n in $notes; do print "  note: $n"; done
  print
  if (( $#conflicted )); then
    print "Conflicts to resolve (look for <<<<<<<):\n  ${(pj:\n  :)conflicted}"
  else
    for clone stock ver in ${=todo}; do
      if out=$(herdr-app check $APP/mods/$clone 2>&1); then print "herdr-app check $clone: ok"
      else print "herdr-app check $clone: FAILED"; print -r -- $out; fi
    done
  fi
  print "\nReview with \`git -C ~/.config/herdr-app diff mods\`, then commit (or \`git checkout mods\` to undo)."
}

case $1 in
  status) [[ $# == 1 || ( $# == 2 && $2 == --quiet ) ]] && { show_status $2; exit; } ;;
  share) [[ $# == 1 ]] && { share; exit; } ;;
  merge) [[ $# == 1 || ( $# == 3 && $2 == --to ) ]] && { merge $3; exit; } ;;
esac
usage_error "give status [--quiet], share, or merge [--to VERSION]"
