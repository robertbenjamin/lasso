#!/bin/zsh
# herdr-open-work --repo <repo|path|home|auto> [--branch B | --pr N] [--linear ID] [--extra] -- <task>
#
# The sidebar (mods/tasks-spaces) runs this for a New work job (mods/new-work) and shows a
# row until it ends. Opens Claude (auto mode) on <task>:
#   home   a new tab in the space of the work folder (workRoot in lasso.json), no worktree.
#          "meta" is an alias.
#   <repo> herdr-worktree --open: a worktree as a new unnamed space under the repo's space
#          (it opens that space too when it is not open). Branch: --branch, the head of
#          PR --pr, or a free city. A repo is a folder path, or a repo name in workRoot
#          (depth 1 or 2).
# Prints the folder. A failure: the reason on stderr, exit 1.
emulate -L zsh
fail() { print -u2 -r -- "$*"; exit 1; }
BIN=${0:A:h}
export PATH=$BIN:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH
WORK=$(herdr-conf workRoot)
CITIES=(amsterdam athens auckland austin bangkok barcelona belgrade bergen berlin bogota
  bordeaux boston bratislava brisbane bruges brussels budapest cairo calgary chicago
  copenhagen cork dakar delhi denver dubai dublin edinburgh florence geneva ghent glasgow
  granada hamburg hanoi havana helsinki istanbul jakarta kyoto krakow lagos lima lisbon
  ljubljana london lyon madrid malmo manila marseille melbourne milan montreal mumbai
  munich nairobi nantes naples oslo osaka ottawa oxford palermo paris porto prague quito
  reykjavik riga rome rotterdam salzburg santiago seattle seoul seville sofia stockholm
  sydney taipei tallinn tbilisi tokyo toronto turin valencia vancouver venice vienna
  vilnius warsaw wellington zagreb zurich)

repo= branch= pr= linear= extra=
while (( $# )); do
  case $1 in
    --repo) repo=$2; shift 2 ;; --branch) branch=$2; shift 2 ;; --pr) pr=$2; shift 2 ;;
    --linear) linear=$2; shift 2 ;; --extra) extra=1; shift ;;
    --) shift; break ;; *) break ;;
  esac
done
task="$*"
[[ -n $repo ]] || { print -u2 "herdr-open-work: no repo"; exit 2; }
[[ $repo == meta ]] && repo=home
[[ $repo == */* && -d $repo/.git ]] || [[ -n $WORK ]] || fail "Set workRoot in $BIN:h/lasso.json, or give --repo as a folder path."

# --repo auto with --linear ID: a ticket label in labelRepo (lasso.json) names the repo. No
# label in the table: home, and Claude asks there.
# Labels come from the Linear API when $LINEAR_API_KEY or the linear-key file is set (fast),
# else from a short `claude -p` call with the claude.ai Linear tool (about 6 s; the dialog
# does not wait for it).
typeset -A LABEL_REPO
while IFS=$'\t' read -r k v; do [[ -n $k ]] && LABEL_REPO[$k]=$v; done < <(herdr-conf labelRepo)
[[ -z $LINEAR_API_KEY && -r $BIN:h/linear-key ]] && LINEAR_API_KEY=$(<$BIN:h/linear-key)
labels_of() {
  if [[ -n $LINEAR_API_KEY ]]; then
    curl -s -m 5 https://api.linear.app/graphql -H "Authorization: $LINEAR_API_KEY" -H 'Content-Type: application/json' \
      -d "{\"query\":\"{ issue(id: \\\"$1\\\") { labels { nodes { name } } } }\"}" \
      | python3 -c 'import json,sys; print("\n".join(n["name"] for n in json.load(sys.stdin)["data"]["issue"]["labels"]["nodes"]))'
  else
    (cd $WORK && claude -p "Call mcp__claude_ai_Linear__get_issue with id $1 and fields [\"labels\"]. Print the label names, one per line, and nothing else." \
      --model haiku --allowedTools=mcp__claude_ai_Linear__get_issue 2>/dev/null)
  fi
}
# The LLM pick: for a note, a Slack link, or a ticket with your own instructions.
llm_repo() {
  local repos=$(find $WORK -mindepth 2 -maxdepth 3 -name .git 2>/dev/null | sed -E 's#/\.git$##; s#.*/##' | sort -u | tr '\n' ' ')
  local map=${(j:, :)${(kv)LABEL_REPO}}
  local got=$(cd $WORK && claude -p "Pick the ONE repo that this work starts in. Repos: $repos.
Linear service labels map to repos (label repo pairs): $map.
If the input has a Linear ticket, call mcp__claude_ai_Linear__get_issue (fields labels, title, description). If it has a Slack link, you may read the thread with mcp__claude_ai_Slack__slack_read_thread.
Reply with only the repo name, or home if it is not clear, spans several repos, or is not about code.
<input>$1</input>" --model haiku --allowedTools=mcp__claude_ai_Linear__get_issue,mcp__claude_ai_Slack__slack_read_thread 2>/dev/null | tail -1 | tr -d '[:space:]`')
  [[ " $repos " == *" $got "* ]] && print -r -- $got || print home
}
if [[ $repo == auto ]]; then
  repo=home
  if [[ -n $linear && -z $extra ]]; then
    # Only a ticket: its label decides at once. No mapped label: the LLM reads the ticket.
    for l in ${(f)"$(labels_of $linear 2>/dev/null)"}; do
      l=${l##[-* ]#}; [[ -n ${LABEL_REPO[$l]} ]] && { repo=${LABEL_REPO[$l]}; break; }
    done
    [[ $repo == home ]] && repo=$(llm_repo "$task")
  else
    repo=$(llm_repo "$task")
  fi
  [[ $repo == home && -n $linear ]] && { branch=; task+=$'\n\n'"You run in the work folder: the repo for $linear was not clear from the ticket. Ask the user which repo before you change code."; }
fi
if [[ $repo == home ]]; then
  sp=$(herdr-space-in $WORK)
  # In the background (herdr-bg-space): a new tab in the work folder's space, else a new space.
  at=(); [[ -n $sp ]] && at=(--space $sp)
  herdr-bg-space $at $WORK claude --permission-mode auto ${task:+"$task"} >/dev/null || fail "Could not open Claude in $WORK."
  print -r -- $WORK; exit 0
fi

if [[ $repo == */* ]]; then main=${repo:A}
else m=($WORK/$repo/.git(N) $WORK/*/$repo/.git(N)); main=${m[1]:h}; fi
[[ -d $main/.git ]] || fail "No repo '$repo' in $WORK."
if [[ -n $pr ]]; then
  slug=$(git -C $main remote get-url origin | sed -E 's#^.*github.com[:/]##; s#\.git$##')
  branch=$(gh pr view $pr --repo $slug --json headRefName -q .headRefName) || fail "PR $pr not found in $slug."
fi
if [[ -z $branch ]]; then
  used=(${(f)"$(git -C $main for-each-ref --format='%(refname:lstrip=2)' refs/heads refs/remotes/origin | sed 's#^origin/##')"} ${(f)"$(ls ~/.herdr/worktrees/${main:t} 2>/dev/null)"})
  free=(${CITIES:|used}); branch=${free[RANDOM % $#free + 1]}
fi
# Its stderr stays: git's own error shows above this line in the failure tab (mods/tasks-spaces).
dir=$(herdr-worktree $main $branch --open ${task:+"$task"}) || fail "Could not make or open the worktree $branch in $repo."
print -r -- $dir
