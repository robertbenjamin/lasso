#!/bin/zsh
# herdr-space-in <folder>
#
# Prints the id of an open space in <folder> on this computer: made there, or its first
# terminal is there now. Prints nothing when there is none.
emulate -L zsh
setopt err_exit pipe_fail
source ${0:A:h}/lib.zsh
cwds=$(hc ls --json | jq '[.terminals[] | {(.address): .cwd}] | add // {}')
herdr-app ls | jq -r --arg folder ${1:a} --argjson cwd $cwds '
  first(.spaces[]
    | select((.machine // "") == "")
    | select(.folder == $folder or $cwd[[.tabs[].terminals[].terminal][0] // ""] == $folder)
    | .id) // empty'
