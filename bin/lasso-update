#!/bin/zsh
# lasso-update: runs each migrations/<name>.zsh that has not run here yet, then records it in
# .migrated (not committed). The git hooks run it after every pull, and install.sh runs it too.
# A migration fixes one breaking change on the user's machine, with no agent and no question.
# It must be safe to run on a fresh install. It exits 0 when done, and anything else to retry
# on the next pull (for example when Herdr is not running).
# It also points this repo's hooks at .githooks when they point anywhere else (a setup made
# without install.sh, or a global core.hooksPath), then copies lib/ as the hooks would have.
emulate -L zsh
setopt null_glob
source ${0:A:h}/lib.zsh
APP=${HERDR_APP_HOME:-~/.config/herdr-app}
# --local: a global core.hooksPath (some security tools set one) would hide lasso's hooks.
if [[ $(git -C $APP config --local core.hooksPath) != .githooks ]]; then
  git -C $APP config --local core.hooksPath .githooks
  herdr-mods-sync share >/dev/null
  print "lasso-update: turned on lasso's git hooks, so later pulls run this by themselves"
fi
done_file=$APP/.migrated
touch $done_file
for m in $APP/migrations/*.zsh; do
  grep -qxF ${m:t} $done_file && continue
  if zsh $m; then print -r -- ${m:t} >> $done_file
  else print -u2 "lasso-update: ${m:t} did not finish, it runs again on the next pull"; fi
done
