#!/bin/zsh
# lasso-session <transcript>: the lines the title and the recap need, in transcript order: every
# user message, every text answer of the agent, and Claude Code's own titles. One JSON object
# per line.
emulate -L zsh
source ${0:A:h}/lib.zsh
awk -v user='"message":{"role":"user","content":"' '
  index($0, user) || index($0, "\"type\":\"ai-title\"") ||
  (index($0, "\"type\":\"assistant\"") && index($0, "\"type\":\"text\""))
' $1
