#!/bin/zsh
# herdr-worktree <repo> <branch> [--open [task]]
#
# A git worktree at ~/.herdr/worktrees/<repo>/<branch> (Herdr's own folder pattern), made
# from a fresh origin/HEAD (the remote's default branch; a repo with no origin: its local
# main or master). An existing branch is checked out as it is. An existing worktree is
# reused. Prints the folder on stdout.
#   <repo>   a folder, or a repo name in workRoot (lasso.json), at depth 1 or 2
#   --open   also open it as a new Herdr space with Claude (auto mode) on [task]. The space
#            is unnamed, so Herdr names it after the folder and the sidebar shows it under
#            the repo's space. Opens the repo's space (main checkout, a shell) first when
#            none is open. The New work dialog (herdr-open-work) uses this too.
# No setup step (package install, codegen): the agent does it when it needs it.
emulate -L zsh
setopt err_exit pipe_fail
source ${0:A:h}/lib.zsh

(( $# >= 2 )) || usage_error "give a repo and a branch"
[[ $3 == (|--open) ]] || usage_error "unknown option $3"
repo=$(repo_dir $1) branch=$2
[[ -n $repo ]] || { print -u2 "herdr-worktree: no repo '$1'"; exit 1; }
shift 2

main=$(main_checkout $repo)
slug=$(print -r -- $branch | sed -E 's/[^A-Za-z0-9._-]+/-/g; s/^-+|-+$//g')
dir=~/.herdr/worktrees/${main:t}/$slug

if [[ ! -d $dir ]]; then
  # The base: origin/HEAD, else origin/main or origin/master (origin/HEAD is often unset, as
  # after `git init` + `git remote add`). No origin at all: the local main, master or HEAD.
  has_ref() { git -C $main show-ref --verify -q $1; }
  base=
  if git -C $main remote get-url origin >/dev/null 2>&1; then
    origin=1
    base=$(git -C $main symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) ||
      for b in main master; do has_ref refs/remotes/origin/$b && { base=origin/$b; break; }; done
    [[ -n $base ]] || base=origin/$(git -C $main ls-remote --symref origin HEAD 2>/dev/null | sed -nE 's#^ref: refs/heads/([^[:space:]]+).*#\1#p' || true)
    [[ $base != origin/ ]] || { print -u2 "herdr-worktree: no default branch on origin of ${main:t}"; exit 1; }
    git -C $main fetch -q origin ${base#origin/}
  else
    origin=
    for b in main master; do has_ref refs/heads/$b && { base=$b; break; }; done
    [[ -n $base ]] || base=HEAD
  fi
  if has_ref refs/heads/$branch; then
    git -C $main worktree add -q $dir $branch >&2
  elif [[ -n $origin ]] && git -C $main fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>/dev/null; then
    # Only on GitHub (an open PR): a local branch that tracks it.
    git -C $main worktree add -q --track -b $branch $dir origin/$branch >&2
  else
    # --no-track: the first push sets the branch's own upstream, not master.
    git -C $main worktree add -q --no-track -b $branch $dir $base >&2
  fi
fi
print -r -- $dir

if [[ $1 == --open ]]; then
  shift
  # In the background: space.new focuses the new space. A terminal labeled with space and tab
  # ids that Herdr does not know becomes a new unnamed space, and the focus stays (AGENTS.md).
  # The repo's own space first (a shell), so the worktree space has a space to show under.
  [[ -n $(herdr-space-in $main) ]] || herdr-bg-space $main >/dev/null
  # repoModel (lasso.json): the repo's Claude model, by repo folder name.
  model=$(repo_model ${main:t})
  herdr-bg-space $dir claude --permission-mode auto ${model:+--model} ${model:+$model} "$@" >/dev/null
fi
