#!/bin/zsh
# lasso-pull: updates lasso (`git pull --ff-only`, then lasso-update). The lasso-data mod runs
# it when Herdr starts and every hour; Herdr picks up the changes live. A pull that can't
# fast-forward changes nothing. "autoUpdate": false in lasso.json turns it off.
# Logs to ~/.herdr/lasso-pull.log.
emulate -L zsh
source ${0:A:h}/lib.zsh
[[ $(herdr-conf autoUpdate) == false ]] && exit 0
# lasso-update here too, not only from the hook: a migration that failed (Herdr was busy)
# retries every hour, not only on the next pull that brings changes.
out=$(git -C ${LASSO_BIN:h} pull -q --ff-only 2>&1; lasso-update 2>&1)
[[ -z $out ]] || print -r -- "$(date '+%F %T') $out" >> ~/.herdr/lasso-pull.log
