#!/bin/zsh
# lasso-tour-agent [claude's options] [task]
#
# A scripted stand-in for Claude, for the tour (mods/tour). It takes claude's arguments,
# tells Herdr its status and title as a real agent does, and plays a fixed scene. No model,
# no network, no tokens. LASSO_AGENT (lib.zsh) puts it in Claude's place.
#   lead    (started by New work) looks at the task and names the session. On its next
#           prompt it starts two children with herdr-child and waits for them with hc wait.
#   child   (started by the lead) works on its task. The child named web first asks you
#           for permission, so it shows as blocked.
# Both then sit at a prompt until their pane closes.
emulate -L zsh
source ${0:A:h}/lib.zsh

ME=${HC_TERMINAL_ID:?lasso-tour-agent: run it in a Herdr terminal (no HC_TERMINAL_ID)}
task=${@[-1]}
DIM=$'\e[2m' BOLD=$'\e[1m' GREEN=$'\e[32m' YELLOW=$'\e[33m' OFF=$'\e[0m'

# OSC 7501 is how an agent reports to Herdr: fields joined by ":", the message in base64.
status() {  # <idle|working|blocked> [message] [kind, when blocked]
  printf '\e]7501;state=%s:app=claude-code%s:msg=%s\a' $1 "${3:+:kind=$3}" "$(print -rn -- "$2" | base64 | tr -d '\n')"
}
name_session() { printf '\e]2;%s\a' "$1"; }
line() { sleep 0.35; print -r -- "$1"; }
says() { line ""; line "${GREEN}●${OFF} $1"; }
does() { line "  ${DIM}⎿ $1${OFF}"; }
# Not "❯": lasso reads that as a real prompt and would ask Haiku for a title.
ask() { print; read -r "?${BOLD}>${OFF} "; }

lead() {
  status working "Reading the checkout test"
  says "I'll run the checkout test a few times to see it fail."
  does "Read test/checkout.test.ts"
  does "npm test -- checkout (10 runs, 1 failed)"
  says "The cause: api retries with no backoff, and web hides the retry from the user."
  name_session "Flaky checkout test"
  status idle
  ask || return

  # As in daily use: one ticket, a sub-issue and a child agent for each repo it touches.
  status working "Starting 2 children"
  says "Two repos, so I'll make a sub-issue for each and start a child on each."
  does "Linear: SHOP-43 (api) and SHOP-44 (web), under SHOP-42"
  export LASSO_AGENT=${ZSH_ARGZERO:A}
  # Slowly, so you can watch each child land in its pane and in the sidebar. The scene shows
  # --worktree, as a real parent would use; the demo has one repo, so the children share it.
  does "herdr-child --worktree api SHOP-43 → $(herdr-child --name api "SHOP-43 api: back off between payment retries")"
  sleep 1.8
  does "herdr-child --worktree web SHOP-44 → $(herdr-child --name web "SHOP-44 web: show the retry at checkout")"
  sleep 1
  status working "Waiting for 2 children"
  does "hc wait --children all"
  hc wait --children all >/dev/null
  if (( $(children blocked) )); then
    says "${YELLOW}A child is blocked: it needs you.${OFF} Click its pane and press Enter."
    while (( $(children blocked) )); do sleep 0.5; done
    hc wait --children all >/dev/null
  fi
  says "Both children are done: two draft PRs are up, one per repo."
  status idle
}

children() {  # <status>: how many of this agent's children have it
  hc ls --json | jq --arg parent $ME --arg state $1 '[.terminals[] | select(.parent == $parent and .status == $state)] | length'
}

child() {
  name_session "$task"
  status working "$task"
  says "On it."
  does "Read the retry code"
  if [[ $1 == web ]]; then
    status blocked "Run npm test?" permission
    line ""
    read -r "?  ${YELLOW}Allow ${BOLD}npm test${OFF}${YELLOW}? Press Enter${OFF} " || return
    status working "$task"
  fi
  does "npm test (passed)"
  says "Done: opened a draft PR."
  status idle
}

info=$(hc get $ME --json)
parent=$(jq -r '.parent // empty' <<<$info)
# Only the lead says this. A child's pane starts narrow, so the line would wrap there, and the
# tour counts a child's lines down to its prompt (mods/tour/places.js).
[[ -n $parent ]] || print -r -- "${DIM}lasso tour: a scripted agent, no tokens${OFF}"
print -r -- "${BOLD}>${OFF} $task"
if [[ -n $parent ]]; then child "$(jq -r '.name // empty' <<<$info)"; else lead; fi
while ask; do line "${DIM}This agent is scripted. Press ⌘⇧N to start a real one.${OFF}"; done
