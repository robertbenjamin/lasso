#!/bin/zsh
# herdr-bg-space [--space ID] <folder> [argv...]
#
# Opens a terminal in <folder> as a new space, or as a new tab in space ID, without taking
# the focus (space.new and tab.new always focus what they open). How: hc starts the terminal
# with herdr.space / herdr.tab labels, and ids Herdr does not know become a new space or tab.
# No argv: the machine's own shell. Prints the terminal's address.
emulate -L zsh
setopt err_exit pipe_fail
space=
[[ $1 == --space ]] && { space=$2; shift 2; }
folder=${1:?herdr-bg-space: no folder}; shift
hc run --json --bg --keep --no-parent --cwd $folder \
  --label herdr.space=${space:-sp$(openssl rand -hex 16)} --label herdr.tab=tb$(openssl rand -hex 16) -- "$@" \
  | jq -r .address
