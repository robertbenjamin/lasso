#!/bin/zsh
# lasso-links-since <transcript> <byte offset> <url regex>: the transcript's size, then the
# URLs written after that offset in your prompts and the agent's messages (tool output holds
# links of other work).
emulate -L zsh
source ${0:A:h}/lib.zsh
size=$(wc -c < $1 | tr -d ' ')
print -r -- $size
(( size > $2 )) || exit 0
tail -c +$(( $2 + 1 )) $1 | head -c $(( size - $2 )) \
  | grep -F -e '"message":{"role":"user","content":"' -e '"type":"assistant"' | grep -oE $3
