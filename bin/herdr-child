#!/bin/zsh
# herdr-child [options] [task]
#
# Start a Claude agent as a child of the agent that runs this (its hc parent), so the
# sidebar and the Work page nest it. By default its pane goes in the caller's tab, in
# columns of two on the right: odd children start a new column, even ones go below. Your focus stays put.
#   --folder DIR             work in DIR (default: the current folder)
#   --worktree REPO BRANCH   work in a fresh worktree (herdr-worktree REPO BRANCH)
#   --name NAME              hc name, the label until Claude names the session
#                            (default: the folder's branch, unless master/main)
#   --space SPACE            a new tab in another space (id or name), not the caller's tab
#   --resume SESSION         resume a Claude session (re-nest an agent: kill the old one after)
#   --model MODEL            Claude's model (claude --model)
#   --effort LEVEL           Claude's effort (claude --effort)
# Set the model and effort here: a slash command sent with hc send does not run.
# Give the task here too, so it is the first message: Claude names the session after it.
# Prints the child's address (t7). Then: hc read / hc wait / hc send <address>.
# The child runs in auto mode and keeps running when the caller ends.
emulate -L zsh
setopt err_exit pipe_fail
source ${0:A:h}/lib.zsh

PARENT=${HC_TERMINAL_ID:?herdr-child: run it from a Herdr terminal (no HC_TERMINAL_ID)}
folder=$PWD name= space= resume= model= effort= task=()
while (( $# )); do
  case $1 in
    --folder) folder=${2:a}; shift 2 ;;
    --worktree) folder=$(herdr-worktree $2 $3); [[ -n $name ]] || name=$3; shift 3 ;;
    --name) name=$2; shift 2 ;;
    --space) space=$2; shift 2 ;;
    --resume) resume=$2; shift 2 ;;
    --model) model=$2; shift 2 ;;
    --effort) effort=$2; shift 2 ;;
    --) shift; task=("$@"); break ;;
    -*) usage_error "unknown option $1" ;;
    *) task=("$@"); break ;;
  esac
done
[[ -d $folder ]] || { print -u2 "herdr-child: no folder $folder"; exit 1; }

# hc names: 1-32 of a-z 0-9 - _, unique among live terminals.
if [[ -z $name ]]; then
  b=$(git -C $folder branch --show-current 2>/dev/null || true)
  [[ $b == (master|main|develop|) ]] || name=$b
fi
if [[ -n $name ]]; then
  name=${(L)name}; name=${${name//[^a-z0-9_-]/-}[1,29]}
  taken=$(hc ls --json | jq -r '[.terminals[].name // empty] | join(" ")')
  n=$name i=2; while [[ " $taken " == *" $n "* ]]; do n=$name-$i; (( i++ )); done; name=$n
fi

# One child of this parent at a time: each reads the last child's pane to go below it.
# A lock older than 30 s is from a call that was killed: take it.
lock=${TMPDIR:-/tmp}/herdr-child-$PARENT.lock
until mkdir $lock 2>/dev/null; do
  (( $(date +%s) - $(stat -f %m $lock 2>/dev/null || print 0) > 30 )) && rmdir $lock 2>/dev/null || true
  sleep 0.1
done
trap 'rmdir $lock 2>/dev/null' EXIT

parents=$(hc ls --json | jq '[.terminals[] | {(.address): .parent}] | add // {}')
eval "$(herdr-app ls | jq -r --arg p $PARENT --arg want "$space" --argjson parent $parents '
  (.spaces[] as $s | $s.tabs[] as $t | $t.terminals[] | select(.terminal == $p)
    | [$t.terminals[] | select($parent[.terminal] == $p and .pane) | .pane] as $kids
    | "SP=\($s.id) TB=\($t.id) PANE=\(.pane // "") LAST=\($kids[-1] // "") KIDS=\($kids | length) KIDP=(\($kids | join(" ")))"),
  (select($want != "") | "OTHER=\(first(.spaces[] | select(.id == $want or .name == $want) | .id) // "")")')"
[[ -n $SP ]] || { print -u2 "herdr-child: $PARENT is not in the Herdr window"; exit 1; }

# Another space: a new tab there, in the background. A tab id that Herdr does not know
# becomes a new tab, and the focus stays (tab.new would focus it).
if [[ -n $space ]]; then
  [[ -n $OTHER ]] || { print -u2 "herdr-child: no space $space"; exit 1; }
  SP=$OTHER TB=tb$(openssl rand -hex 16)
fi

cmd=(claude --permission-mode auto)
[[ -n $resume ]] && cmd+=(--resume $resume)
[[ -n $model ]] && cmd+=(--model $model)
[[ -n $effort ]] && cmd+=(--effort $effort)
(( $#task )) && cmd+=("${task[*]}")
args=(--bg --json --outlive-parent --cwd $folder --label herdr.space=$SP --label herdr.tab=$TB)
# With its tab's labels and --keep, Herdr gives the child a pane as a new column on the right, with no focus change.
[[ -z $space ]] && args+=(--keep)
[[ -n $name ]] && args+=(--name $name)
addr=$(hc run $args $cmd | jq -r .address)

# Herdr has no "place this pane there", and its own spot for a new pane is beside the last
# pane, inside that pane's column. So: split empty slots where the child should go, swap the
# child into one, close the rest. No agent pane is focused, so a background tab stays in the
# background and its done agents stay done.
read -r shown you <<<$(herdr-app status | jq -r '"\(.tab // "-") \(.focused_pane // "")"')
you=${you:-$PANE}
split() {  # <pane> <right|down>: prints the empty slot
  local slot i
  slot=$(herdr-app do pane.split "{\"direction\":\"$2\",\"pane\":\"$1\"}" | jq -r '.pane // empty')
  [[ -n $slot ]] || return 1
  # The split takes the focus when its tab is on screen (a moment later): give it back.
  if [[ $shown == $TB ]]; then
    for i in {1..20}; do
      herdr-app do pane.focus --pane $you >/dev/null
      [[ $(herdr-app status | jq -r '.focused_pane // ""') == $you ]] && break; sleep 0.1
    done
  fi
  print -r -- $slot
}
swap() { herdr-app do pane.swap "{\"pane\":\"$1\",\"target\":\"$2\"}" >/dev/null; }
refocus() {  # the focus can land on a closed slot's neighbour
  [[ $shown != $TB || $(herdr-app status | jq -r '.focused_pane // ""') == $you ]] || herdr-app do pane.focus --pane $you >/dev/null
}
# An even child goes below the last one.
stack_below() {  # <pane to go below>
  local slot
  [[ -n $pane ]] && slot=$(split $1 down) || return 1
  swap $pane $slot
  herdr-app do pane.close --pane $slot >/dev/null
  refocus
}
# An odd child starts a new column on the right. Only a split of the caller's pane makes a
# top-level column, and it lands next to the caller: so make an empty pair there, move every
# child two slots back (each column one to the left), and the pair ends up last.
new_column() {
  local s1 s2 k
  # A split halves a pane, and no command sizes a column: so double the caller's weight first,
  # and it and the new column each get 0.5, the weight of every column before them.
  herdr-app do layout.resize "{\"id\":\"$PANE\",\"weight\":1}" >/dev/null
  [[ -n $pane ]] && s1=$(split $PANE right) && s2=$(split $s1 down) || return 1
  for k in $KIDP; do swap $k $s1; read s1 s2 <<<"$s2 $s1"; done
  # s1 and s2 now hold the last column (s1 on top): the child takes s1.
  swap $pane $s1
  herdr-app do pane.close --pane $s1 >/dev/null
  herdr-app do pane.close --pane $s2 >/dev/null
  # Herdr's own placement may have split a column's width: the child is a block now, so size it.
  herdr-app do layout.resize "{\"id\":\"$pane\",\"weight\":0.5}" >/dev/null
  refocus
}
# Wait for Herdr to give the child its pane, even the first one: the next call (still locked
# out) finds the last child by its pane, and without one it starts a new column.
pane=
if [[ -z $space ]]; then
  for i in {1..40}; do
    pane=$(pane_of $addr)
    [[ -n $pane ]] && break; sleep 0.1
  done
fi
# The child runs either way: a failure here must not hide its address.
if [[ -z $space && -n $LAST ]]; then
  if (( KIDS % 2 )); then stack_below $LAST; else new_column; fi ||
    print -u2 "herdr-child: could not place $addr; it stays where Herdr put it"
fi
print -r -- $addr
