#!/bin/zsh
# herdr-new-work-test: runs herdr-open-work as the sidebar does, against temp repos (each with
# a bare origin): a repo given as a path, a repo name in workRoot, a plain prompt (the LLM
# pick) and home (a worktree of the work folder, itself a git repo). Checks the end state,
# then removes what it made (spaces, worktrees, temp repos). Exit 1 when a check fails.
# Needs Herdr running and the claude CLI logged in.
#   - one new space in the worktree folder, named after its repo
#   - the repo's own space is open, so the sidebar shows the worktree under it
#   - Claude runs in it (its first screen), not a shell
emulate -L zsh
# No err_exit: a failed check is counted and the test goes on.
setopt pipe_fail
source ${0:A:h}/lib.zsh
T=${$(mktemp -d):A}
W=$T/lasso-nwtest-work
export HERDR_WORK_ROOT=$W
for r in lasso-nwtest-work lasso-nwtest-work/lasso-nwtest-api lasso-nwtest-work/lasso-nwtest-billing; do
  git init -q -b main $T/src/${r:t} && git -C $T/src/${r:t} commit -q --allow-empty -m init
  git clone -q --bare $T/src/${r:t} $T/origin/${r:t}.git && git clone -q $T/origin/${r:t}.git $T/$r
done
fails=0
ok() { print -P "  %F{green}ok%f   $1"; }
bad() { print -P "  %F{red}FAIL%f $1"; fails=$((fails + 1)); }
space_ids() { herdr-app ls | jq -r '.spaces[].id'; }
# Herdr shows a closed space again while its terminals still run (a working Claude exits
# slowly), and it would spill into the next check or run: wait up to 5 s, then kill.
close_space() {  # <space id>
  local t i
  local ts=(${(f)"$(herdr-app ls | jq -r --arg s $1 '.spaces[] | select(.id == $s) | .tabs[].terminals[].terminal')"})
  herdr-app do space.close "{\"id\":\"$1\",\"confirmed\":true}" >/dev/null
  for t in $ts; do
    for i in {1..50}; do [[ $(hc get $t --json 2>/dev/null | jq -r .state) == live ]] || continue 2; sleep 0.1; done
    print -u2 "  (still running after 5 s: killing $t)"; hc kill $t >/dev/null 2>&1
  done
}

check() { # <name> <expected main checkout> <branch> <args…>
  local name=$1 main=$2 branch=$3; shift 3
  print "$name"
  local before=(${(f)"$(space_ids)"}) t0=$SECONDS
  local dir; dir=$(herdr-open-work "$@" 2>&1 | tail -1)
  local took=$((SECONDS - t0))
  local wantdir=~/.herdr/worktrees/${main:t}/$branch
  [[ $dir == $wantdir ]] && ok "repo ${main:t}, worktree $branch (${took}s)" || bad "printed '$dir', want $wantdir"
  # mods/lasso-data names the space after its repo on its next render: wait up to 15 s for it.
  local i; for i in {1..15}; do
    sleep 1
    (( i >= 4 )) && [[ $(herdr-app ls | jq -r --arg wt $wantdir '[.spaces[] | select(.folder == $wt) | .name][0]') == ${main:t} ]] && break
  done
  # count, name, id and first terminal of the new worktree spaces, the repo's space, and the
  # repo spaces this test opened
  local info=$(herdr-app ls | jq -r --arg wt $wantdir --arg main $main '
    [.spaces[] | select(.id | IN($ARGS.positional[]) | not)] as $new
    | [$new[] | select(.folder == $wt)] as $w
    | [($w | length), $w[0].name, $w[0].id, $w[0].tabs[0].terminals[0].terminal,
       [.spaces[] | select(.folder == $main) | .id][0],
       ([$new[] | select(.folder == $main) | .id] | join(" "))]
    | map(. // "") | join(" ")' --args $before)
  local -a f=(${=info})
  [[ $f[1] == 1 ]] && ok "one space in the worktree" || bad "spaces in the worktree: $f[1]"
  # Only the new spaces count: you may click around in other panes while the test runs.
  local shown=$(herdr-app status | jq -r '.space // ""')
  [[ -n $shown && " $f[3] $f[6] " == *" $shown "* ]] && bad "focus moved to the new space $shown" || ok "focus stays out of the new spaces"
  [[ $f[2] == ${main:t} ]] && ok "named after its repo, $f[2]" || bad "space name '$f[2]', want ${main:t}"
  [[ -n $f[5] ]] && ok "the ${main:t} space is open (worktree shows under it)" || bad "no ${main:t} space open"
  local screen=$(hc read $f[4] 2>/dev/null)
  [[ $screen == *"Claude Code"* || $screen == *"Accessing workspace"* ]] && ok "Claude runs in $f[4]" || bad "no Claude in $f[4]"
  for id in $f[3] ${=f[6]}; do close_space $id; done
  git -C $main worktree remove --force $wantdir 2>/dev/null
}

check "Repo as a path" $W/lasso-nwtest-api nwtest-path --repo $W/lasso-nwtest-api --branch nwtest-path -- "Reply ok only."
check "Repo name in workRoot" $W/lasso-nwtest-api nwtest-name --repo lasso-nwtest-api --branch nwtest-name -- "Reply ok only."
check "Plain prompt (LLM pick)" $W/lasso-nwtest-billing nwtest-prompt --repo auto --branch nwtest-prompt -- "add a retry to the invoice PDF generation in the billing service. Reply ok only."
check "Home (work folder)" $W nwtest-home --repo home --branch nwtest-home -- "Reply ok only."
rm -rf $T ~/.herdr/worktrees/lasso-nwtest-*
(( fails )) && { print -P "%F{red}$fails failed%f"; exit 1; } || print -P "%F{green}all passed%f"
