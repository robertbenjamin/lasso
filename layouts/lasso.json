{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "work-nav",
          "type": "block",
          "size": {
            "px": 36
          },
          "content": {
            "mod": "tasks",
            "props": {
              "nav": true
            }
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "tasks-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 36
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "tasks"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "claude-footer"
          },
          "size": {
            "px": 141
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work-stack",
      "type": "stack",
      "active": "work",
      "children": [
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "tasks-tabs"
              },
              "size": {
                "px": 42
              },
              "window_drag": true
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "tasks-pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        },
                        {
                          "id": "context",
                          "type": "block",
                          "content": {
                            "mod": "context"
                          }
                        }
                      ],
                      "active": "files"
                    }
                  ],
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": true
                }
              ],
              "padding": 8,
              "gap": 8
            },
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "workspace-status"
              },
              "size": {
                "px": 28
              }
            },
            {
              "id": "lasso-data",
              "type": "block",
              "size": {
                "px": 0
              },
              "content": {
                "mod": "lasso-data"
              }
            }
          ],
          "resizable": false
        },
        {
          "id": "board-page",
          "type": "column",
          "children": [
            {
              "id": "board-bar",
              "type": "block",
              "size": {
                "px": 42
              },
              "window_drag": true,
              "content": {
                "mod": "tasks",
                "props": {
                  "boardBar": true
                }
              }
            },
            {
              "id": "board-body",
              "type": "row",
              "padding": 8,
              "children": [
                {
                  "id": "work-board",
                  "type": "block",
                  "background": "background",
                  "radius": 10,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "content": {
                    "mod": "tasks",
                    "props": {
                      "board": true
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "floating": [
    {
      "id": "tour",
      "content": {
        "mod": "tour"
      },
      "edge": "bottom",
      "align": "end"
    }
  ],
  "background": "canvas",
  "colors": {
    "blocked": "#e93d82"
  },
  "terminal_padding": [14, 12],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [12, 16]
}
