# lasso: track only the files lasso adds. Everything else is Herdr's (stock files, state,
# secrets) or yours (lasso.json, linear-key).
/*
!.gitignore
!README.md
!CLAUDE.md
!keys.json
!settings.json
!lasso.example.json
!herdr-agents.md
!install.sh
!package.json
!package-lock.json
!.oxlintrc.json
!.oxfmtrc.json
!.git-blame-ignore-revs
!test/
!lib/
!bin/
!migrations/
!.githooks/
!layouts/
layouts/*
!layouts/lasso.json
!claude-mods/
!.claude-plugin/
!mods/
mods/*
!mods/tasks/
!mods/tasks-pane/
!mods/tasks-spaces/
!mods/tasks-tabs/
!mods/new-work/
!mods/claude-footer/
!mods/lasso-data/
!mods/context/
!mods/tour/
# Herdr writes this type file into every mod.
*.d.ts
# Claude Code writes this, and a types folder, into a mod it loads with --plugin-dir.
claude-mods/*/tsconfig.json
# Copies of lib/, made by `herdr-mods-sync share`.
mods/*/lib/
