# lasso: track only the files lasso adds. Everything else is Herdr's (stock files, state,
# secrets) or yours (lasso.json, linear-key).
/*
!.gitignore
!README.md
!CLAUDE.md
!keys.json
!settings.json
!lasso.example.json
!herdr-agents.md
!install.sh
!bin/
!layouts/
layouts/*
!layouts/main-tasks.json
!mods/
mods/*
!mods/tasks/
!mods/tasks-pane/
!mods/tasks-spaces/
!mods/tasks-tabs/
!mods/new-work/
!mods/claude-footer/
!mods/context/
# Herdr writes this type file into every mod.
*.d.ts
